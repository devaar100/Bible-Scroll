{
  "hosting": {
    "site": "biblescroll-legal",
    "public": ".",
    "ignore": ["firebase.json", "README.md", "**/.*"],
    "cleanUrls": false,
    "trailingSlash": true,
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {"key": "Cache-Control", "value": "public, max-age=300"},
          {"key": "X-Content-Type-Options", "value": "nosniff"}
        ]
      }
    ]
  }
}
