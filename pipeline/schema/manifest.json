{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biblescroll.invalid/schema/manifest.json",
  "title": "Study content manifest",
  "description": "manifest.json at the content root. The app fetches it, then downloads any book whose contentVersion differs from what it has.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "schemaVersion", "release", "books", "discover", "devotionals"],
  "properties": {
    "formatVersion": {"const": 1},
    "schemaVersion": {"const": 2},
    "release": {"description": "Hash of everything below; changes whenever any file does.", "type": "string", "pattern": "^[0-9a-f]{12}$"},
    "books": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["book", "bookId", "url", "contentVersion", "verseCount", "reviewedCount", "sha256", "bytes"],
        "properties": {
          "book": {"type": "string", "pattern": "^[1-3A-Z][A-Z0-9]{2}$"},
          "bookId": {"type": "integer", "minimum": 1, "maximum": 66},
          "url": {"description": "Absolute URL, or relative to manifest.json when no baseUrl is configured.", "type": "string"},
          "contentVersion": {"type": "string", "pattern": "^[0-9a-f]{12}$"},
          "verseCount": {"type": "integer", "minimum": 1},
          "reviewedCount": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "discover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "count", "sha256", "bytes"],
      "properties": {
        "url": {"type": "string"},
        "count": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "devotionals": {
      "description": "One immutable file per month (schema/devotional_month.json). Months with nothing publishable yet are absent.",
      "type": "object",
      "additionalProperties": false,
      "required": ["months"],
      "properties": {
        "months": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["month", "url", "contentVersion", "count", "reviewedCount", "sha256", "bytes"],
            "properties": {
              "month": {"type": "string", "pattern": "^(0[1-9]|1[0-2])$"},
              "url": {"type": "string"},
              "contentVersion": {"type": "string", "pattern": "^[0-9a-f]{12}$"},
              "count": {"type": "integer", "minimum": 1},
              "reviewedCount": {"type": "integer", "minimum": 0},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "bytes": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "community": {
      "description": "Community spotlight ministries (C1/C2), /ministries.json (schema/ministries.json). Absent until one is published.",
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "count", "sha256", "bytes"],
      "properties": {
        "url": {"type": "string"},
        "count": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
