{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biblescroll.invalid/schema/plan.json",
  "title": "Reading plan",
  "description": "A curated reading plan (H8-H11). Structural plans are computed from word counts; topical and chronological plans are drafted with AI and need human review before they ship. Verse numbers follow the app's KJV versification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schemaVersion", "contentVersion", "title", "shortDescription", "description", "category",
               "difficulty", "days", "estimatedMinutesPerDay", "status", "origin", "credits", "meta"],
  "properties": {
    "id": {"description": "Stable slug, e.g. john-21-days.", "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60},
    "schemaVersion": {"const": 1},
    "contentVersion": {"type": "string", "pattern": "^[0-9a-f]{12}(\\.[0-9]+)?$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 60},
    "shortDescription": {"description": "One-line hook for the plan card.", "type": "string", "minLength": 1, "maxLength": 120},
    "description": {"description": "About this plan (plan detail).", "type": "string", "minLength": 1, "maxLength": 800},
    "category": {"$ref": "#/$defs/category"},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "days": {"type": "array", "minItems": 1, "maxItems": 366, "items": {"$ref": "#/$defs/day"}},
    "estimatedMinutesPerDay": {"description": "Typical reading time per day at about 200 words a minute.", "type": "integer", "minimum": 1, "maximum": 60},
    "status": {"enum": ["generated", "auto_checked", "flagged", "reviewed"]},
    "origin": {
      "description": "structural: computed from word counts (ships once it validates). ai_drafted: passages and intros drafted with AI (ships only once reviewed).",
      "enum": ["structural", "ai_drafted"]
    },
    "credits": {"description": "Shown on the plan detail page.", "type": "string", "minLength": 1, "maxLength": 300},
    "i18n": {"description": "Translations by language code (e.g. \"es\"). English stays in the top-level fields.", "type": "object", "propertyNames": {"type": "string", "pattern": "^[a-z]{2}$"}, "additionalProperties": {"$ref": "#/$defs/planLocale"}},
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatedAt"],
      "properties": {
        "model": {"description": "Model that drafted the plan (ai_drafted only).", "type": "string", "minLength": 1},
        "generatedAt": {"$ref": "#/$defs/dateTime"},
        "reviewedBy": {"type": "string", "minLength": 1},
        "reviewedAt": {"$ref": "#/$defs/dateTime"},
        "editedBy": {"type": "string", "minLength": 1},
        "editedAt": {"$ref": "#/$defs/dateTime"}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkedAt", "checkerVersion", "reasons"],
      "properties": {
        "checkedAt": {"$ref": "#/$defs/dateTime"},
        "checkerVersion": {"type": "string", "minLength": 1},
        "reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "message"],
            "properties": {
              "check": {"enum": ["schema", "passage", "empty_day", "day_length", "day_numbers", "coverage", "verification", "reviewer", "regenerate"]},
              "message": {"type": "string", "minLength": 1},
              "day": {"type": "integer", "minimum": 1},
              "by": {"type": "string", "minLength": 1},
              "at": {"$ref": "#/$defs/dateTime"}
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "description": "A flagged plan says why.",
      "if": {"properties": {"status": {"const": "flagged"}}},
      "then": {"required": ["checks"], "properties": {"checks": {"properties": {"reasons": {"minItems": 1}}}}}
    },
    {
      "description": "A reviewed plan records who reviewed it and when.",
      "if": {"properties": {"status": {"const": "reviewed"}}},
      "then": {"properties": {"meta": {"required": ["reviewedBy", "reviewedAt"]}}}
    },
    {
      "description": "AI-drafted plans name the model.",
      "if": {"properties": {"origin": {"const": "ai_drafted"}}},
      "then": {"properties": {"meta": {"required": ["model"]}}}
    }
  ],
  "$defs": {
    "planLocale": {
      "description": "One language's text for this plan (pipeline `translate plans`). Limits are about 25% above English.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sourceVersion", "title", "shortDescription", "description", "meta"],
      "properties": {
        "status": {"description": "translated: written, not yet checked. auto_checked: free checks and the drift check passed. flagged: needs a person (see checks). reviewed: a person approved it. stale: the English changed since (sourceVersion != contentVersion); not shipped until retranslated.", "enum": ["translated", "auto_checked", "flagged", "reviewed", "stale"]},
        "sourceVersion": {"description": "contentVersion of the English this was translated from.", "type": "string"},
        "title": {"type": "string", "minLength": 1, "maxLength": 75},
        "shortDescription": {"type": "string", "minLength": 1, "maxLength": 150},
        "description": {"type": "string", "minLength": 1, "maxLength": 1000},
        "credits": {"type": "string", "minLength": 1, "maxLength": 375},
        "days": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["dayNumber"],
                 "properties": {"dayNumber": {"type": "integer", "minimum": 1}, "title": {"type": "string", "minLength": 1, "maxLength": 100}, "intro": {"type": "string", "minLength": 1, "maxLength": 750}}}},
        "meta": {"description": "Models, times and reviewer. Never published.", "type": "object", "additionalProperties": false,
                 "properties": {"model": {"type": "string"}, "driftModel": {"type": "string"}, "translatedAt": {"type": "string"}, "checkedAt": {"type": "string"},
                                "reviewedBy": {"type": "string"}, "reviewedAt": {"type": "string"}, "usage": {"type": "object"},
                                "promptHash": {"description": "SHA-256 of the translation system prompt sent.", "type": "string"},
                                "driftPromptHash": {"description": "SHA-256 of the drift-check system prompt sent.", "type": "string"},
                                "retried": {"description": "A blocking problem was found and the one retry was used.", "type": "boolean"}}},
        "checks": {"description": "Why it was flagged. Never published.", "type": "object", "additionalProperties": false,
                   "properties": {"checkerVersion": {"type": "string"}, "reasons": {"type": "array", "items": {"type": "object"}}, "drift": {"type": "object"},
                                  "minor": {"description": "Non-blocking drift notes (tone, nuance, quotation, style, other).", "type": "array", "items": {"type": "object"}}}}
      }
    },
    "category": {
      "description": "H8 carousels. 'Start here' is a featured list in index.json, not a category of its own.",
      "enum": ["topics-and-seasons", "gospels-and-acts", "letters-and-revelation", "old-testament-stories", "year-round-habits"]
    },
    "dateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dayNumber", "passages"],
      "properties": {
        "dayNumber": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1, "maxLength": 80},
        "intro": {"description": "Short, warm introduction to the day's reading (topical plans).", "type": "string", "minLength": 1, "maxLength": 600},
        "passages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/passage"}}
      }
    },
    "passage": {
      "description": "An inclusive range within one book.",
      "type": "object",
      "additionalProperties": false,
      "required": ["book", "startChapter", "startVerse", "endChapter", "endVerse"],
      "properties": {
        "book": {"description": "USFM code, e.g. JHN.", "type": "string", "pattern": "^[1-3A-Z][A-Z0-9]{2}$"},
        "startChapter": {"type": "integer", "minimum": 1},
        "startVerse": {"type": "integer", "minimum": 1},
        "endChapter": {"type": "integer", "minimum": 1},
        "endVerse": {"type": "integer", "minimum": 1}
      }
    }
  }
}
