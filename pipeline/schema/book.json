{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biblescroll.invalid/schema/book.json",
  "title": "Published book of studies",
  "description": "One book's published studies (studies/v{contentVersion}/{BOOK}.json.gz, gzip of this JSON). Only auto_checked and reviewed studies; internal check reasons and reviewer names are removed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "book", "schemaVersion", "verses"],
  "properties": {
    "formatVersion": {"const": 1},
    "book": {"type": "string", "pattern": "^[1-3A-Z][A-Z0-9]{2}$"},
    "schemaVersion": {"const": 2},
    "verses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contentVersion", "originalLanguage", "crossReferences", "meaning", "historicalContext",
                     "lifeInBibleTimes", "theology", "didYouKnow", "applyIt", "citations", "reviewed", "model"],
        "properties": {
          "id": {"type": "string", "pattern": "^[1-3A-Z][A-Z0-9]{2}\\.[1-9][0-9]*\\.[1-9][0-9]*$"},
          "contentVersion": {"type": "string"},
          "originalLanguage": {"$ref": "study.json#/properties/originalLanguage"},
          "crossReferences": {"$ref": "study.json#/properties/crossReferences"},
          "meaning": {"type": "string", "minLength": 1},
          "historicalContext": {"type": "string", "minLength": 1},
          "lifeInBibleTimes": {"type": "string", "minLength": 1},
          "theology": {"type": "string", "minLength": 1},
          "didYouKnow": {"type": "string", "minLength": 1},
          "applyIt": {"type": "string", "minLength": 1},
          "citations": {"$ref": "study.json#/properties/citations"},
          "reviewed": {"description": "A person approved this study (status 'reviewed').", "type": "boolean"},
          "model": {"description": "Model that wrote the prose, for the 'AI-assisted' label.", "type": "string", "minLength": 1}
        }
      }
    }
  }
}
