<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup on Android 8-11 (Android 12+ uses data_extraction_rules.xml). Include-only: anything not listed
  stays out, so a new file is never backed up by accident. Backed up: the user's own data and settings.
  Left out: bible.db (ships in the app), plans.db (rebuilt from assets), content.db and content-cache
  (re-downloadable studies, devotionals, Discover), WorkManager's job DB, the -shm index files, caches and
  noBackupFilesDir (restore marker, user-db-rescue). BibleScrollBackupAgent checkpoints user.db's WAL first.
  Expected size: under 0.5 MB typically, about 8 MB in an extreme case (see docs/decisions.md). Limit: 25 MB.
-->
<full-backup-content>
    <include domain="database" path="user.db" />
    <include domain="database" path="user.db-wal" />
    <include domain="file" path="datastore/settings.preferences_pb" />
    <!-- Language chosen in S2 on Android 8-12 (13+ keeps it in the system). -->
    <include domain="sharedpref" path="app_language.xml" />
</full-backup-content>
