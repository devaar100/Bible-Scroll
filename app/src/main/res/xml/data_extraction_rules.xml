<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup (to the person's Google account) and device-to-device transfer. Same include-only set as
  backup_rules.xml: user.db (+ its WAL) and the settings DataStore. Everything else stays on the phone.
  Cloud backup only runs when Android can encrypt it end to end (the person has a screen lock), because it
  holds personal notes. Device transfer is direct, so it has no such condition.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="user.db" />
        <include domain="database" path="user.db-wal" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="sharedpref" path="app_language.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="user.db" />
        <include domain="database" path="user.db-wal" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="sharedpref" path="app_language.xml" />
    </device-transfer>
</data-extraction-rules>
