<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer (API 31+). Study content (content.db) is a re-downloadable cache: never copied. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="content.db" />
        <exclude domain="database" path="content.db-shm" />
        <exclude domain="database" path="content.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="content.db" />
        <exclude domain="database" path="content.db-shm" />
        <exclude domain="database" path="content.db-wal" />
    </device-transfer>
</data-extraction-rules>
