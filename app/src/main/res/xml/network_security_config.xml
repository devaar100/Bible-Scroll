<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system CAs only. Every host the app contacts is listed in docs/network-calls.md. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
