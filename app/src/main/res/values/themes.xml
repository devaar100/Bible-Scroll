<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.BibleScroll" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Launch theme: the splash stays up until settings load, so the first frame is already the right theme. -->
    <style name="Theme.BibleScroll.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.BibleScroll</item>
    </style>
</resources>
