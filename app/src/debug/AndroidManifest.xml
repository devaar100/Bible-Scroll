<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (src/debug): never merged into release. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          Imports pipeline study JSON files for testing before anything is published (DebugStudyImport.kt).
          Exported so `adb shell am broadcast` can reach it, but guarded by DUMP, which only the shell and the
          system hold: other apps can't trigger it.
        -->
        <receiver
            android:name=".debug.DebugStudyImportReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="aarnav100.developer.biblescroll.debug.IMPORT_STUDIES" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
